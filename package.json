{
  "name": "devtrace",
  "displayName": "DevTrace",
  "description": "DevTrace is a local-first development session recorder for VS Code.",
  "version": "1.0.0",
  "publisher": "mykcodes",
  "author": {
    "name": "Mayank Sharma",
    "url": "https://mykcodes.tech"
  },
  "icon": "media/icon.jpg",
  "repository": {
    "type": "git",
    "url": "https://github.com/mykcodes/CodeDing---VS-Code-Extension.git"
  },
  "engines": {
    "vscode": "^1.93.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "sound",
    "terminal",
    "audio",
    "success",
    "error",
    "record",
    "history"
  ],
  "extensionDependencies": [
    "vscode.git"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "devtrace.openTimeline",
        "title": "DevTrace: Open Timeline"
      },
      {
        "command": "devtrace.startSession",
        "title": "DevTrace: Start New Session"
      },
      {
        "command": "devtrace.endSession",
        "title": "DevTrace: End Session"
      },
      {
        "command": "devtrace.createDebugReport",
        "title": "DevTrace: Create Debug Report"
      },
      {
        "command": "devtrace.searchHistory",
        "title": "DevTrace: Search Session History"
      },
      {
        "command": "devtrace.clearHistory",
        "title": "DevTrace: Clear Session History"
      },
      {
        "command": "codeding.chooseSuccessSound",
        "title": "DevTrace (Audio): Choose Success Sound"
      },
      {
        "command": "codeding.chooseErrorSound",
        "title": "DevTrace (Audio): Choose Error Sound"
      },
      {
        "command": "codeding.testSuccessSound",
        "title": "DevTrace (Audio): Test Success Sound"
      },
      {
        "command": "codeding.testErrorSound",
        "title": "DevTrace (Audio): Test Error Sound"
      },
      {
        "command": "codeding.resetSuccessSound",
        "title": "DevTrace (Audio): Reset Success Sound"
      },
      {
        "command": "codeding.resetErrorSound",
        "title": "DevTrace (Audio): Reset Error Sound"
      },
      {
        "command": "codeding.openSettings",
        "title": "DevTrace: Open Settings"
      },
      {
        "command": "codeding.toggle",
        "title": "DevTrace (Audio): Toggle Enable/Disable"
      }
    ],
    "configuration": {
      "title": "DevTrace",
      "properties": {
        "codeding.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable or disable audio notifications globally."
        },
        "codeding.successEnabled": {
          "type": "boolean",
          "default": true,
          "description": "Play a sound when a command successfully completes (exit code 0)."
        },
        "codeding.errorEnabled": {
          "type": "boolean",
          "default": true,
          "description": "Play a sound when a command fails (non-zero exit code)."
        },
        "codeding.successSound": {
          "type": "string",
          "default": "",
          "description": "Absolute path to a custom .wav file for success. If empty or invalid, the built-in default success sound is used."
        },
        "codeding.errorSound": {
          "type": "string",
          "default": "",
          "description": "Absolute path to a custom .wav file for errors. If empty or invalid, the built-in default error sound is used."
        },
        "codeding.triggerMode": {
          "type": "string",
          "enum": [
            "codeRun",
            "allTerminalCommands",
            "custom"
          ],
          "default": "codeRun",
          "description": "Determines which terminal commands trigger sounds. 'codeRun' detects builds/scripts and ignores simple navigation commands like 'cd' and 'ls'. 'allTerminalCommands' triggers on everything. 'custom' uses regex patterns."
        },
        "codeding.customCommands": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "A list of Regex strings. Only commands matching these patterns will trigger sounds when triggerMode is set to 'custom'."
        },
        "codeding.notificationLevel": {
          "type": "string",
          "enum": [
            "quiet",
            "diagnostics"
          ],
          "default": "quiet",
          "description": "Level of notifications DevTrace should show."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src --ext ts",
    "test": "node ./out/test/runTest.js"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.6",
    "@types/node": "^18.19.0",
    "@types/vscode": "^1.93.0",
    "@typescript-eslint/eslint-plugin": "^7.1.0",
    "@typescript-eslint/parser": "^7.1.0",
    "@vscode/test-electron": "^2.3.9",
    "eslint": "^8.56.0",
    "mocha": "^10.3.0",
    "typescript": "^5.3.3"
  }
}
